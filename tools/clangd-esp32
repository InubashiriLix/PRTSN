#!/bin/sh
set -eu

if command -v clangd >/dev/null 2>&1; then
	CLANGD="$(command -v clangd)"
else
	CLANGD="/usr/bin/clangd"
fi

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_ROOT="$(dirname -- "$SCRIPT_DIR")"
CLANGD_DB="$PROJECT_ROOT/.clangd-db"

if [ -f "$CLANGD_DB/compile_commands.json" ]; then
	exec "$CLANGD" \
		"$@" \
		--compile-commands-dir="$CLANGD_DB" \
		--query-driver="$HOME/.arduino15/packages/esp32/tools/esp-rv32/*/bin/riscv32-esp-elf-*"
fi

exec "$CLANGD" \
	"$@" \
	--query-driver="$HOME/.arduino15/packages/esp32/tools/esp-rv32/*/bin/riscv32-esp-elf-*"
